  "next_id": 1,
  "meta": {
    "about": "SoundCraft, with the audio engine for the bounce as Audio. Four bars at 104 BPM: a bright synth hook, a bass line, and a drum-synth groove, with a little delay and plate reverb on the hook so it sounds expensive. Bounces a normalized WAV for your phone, and exports MIDI and MusicXML so you can take it into a notation app. Change the notes in the MIDI notes nodes and everything follows. WAV to Audio turns the bounce into Audio, ready for any Audio input; here it's measured with Loudness, and the reading saved.",
    "tags": [
      "music",
      "audio"
    ],
    "title": "A ringtone that isn't annoying"
  },
  "engines": [
    "soundcraft",
    "audio"
  ]
