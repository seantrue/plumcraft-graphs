  "meta": {
    "about": "SoundCraft → audio engine → GridCraft. SoundCraft plays sixteen beats at 100 BPM from a drummer who drifts ahead of the click; the audio engine finds every hit in the bounce, and GridCraft lines each one up against where it should have landed, charts the error in milliseconds and gives a verdict. Swap the notes for a real take (Load audio) to judge a real drummer.",
    "tags": [
      "music",
      "analysis",
      "audio-to-data"
    ],
    "title": "Is the drummer rushing?"
  },
