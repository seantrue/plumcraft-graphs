  "meta": {
    "about": "PhotoCraft → array engine → GridCraft. PhotoCraft gives the plums an aggressive 'Instagram' edit (auto tone, +35 brightness, +90 contrast, a hot colour lookup); the array engine takes a 32-bin histogram of each channel of the before and the after; GridCraft charts them and counts how much of each channel is crushed to black or blown to white. The PDF answers 'did I overdo it?' with numbers.",
    "tags": [
      "photo",
      "analysis",
      "image-to-data"
    ],
    "title": "Is my photo clipping?"
  },
